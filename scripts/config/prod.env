# Production Environment Configuration
# Django settings
DJANGO_PORT=8000
DJANGO_DEBUG=false
DJANGO_SETTINGS_MODULE=sns.settings_prod
ALLOWED_HOSTS=localhost,127.0.0.1

# SvelteKit settings
SVELTEKIT_BUILD=true
SVELTEKIT_PREVIEW_PORT=4173

# Database settings
DATABASE_BACKUP_BEFORE_RESET=true
AUTO_MIGRATE=false

# Virtual environment settings
VENV_PATH=.venv
PYTHON_MIN_VERSION=3.8

# Node.js settings
NODE_MIN_VERSION=16

# Static files
STATIC_ROOT=staticfiles
MEDIA_ROOT=media
COLLECT_STATIC=true

# Logging settings
LOG_LEVEL=WARNING
LOG_FILE=scripts/logs/production.log

# Path settings
FRONTEND_PATH=web-frontend/app
BACKEND_PATH=sns
REQUIREMENTS_FILE=requirements.txt

# Security settings
SECRET_KEY_FILE=.env.secret
SSL_ENABLED=false

# Process management
GRACEFUL_SHUTDOWN_TIMEOUT=30