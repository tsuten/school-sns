# Development Environment Configuration
# Django settings
DJANGO_PORT=8000
DJANGO_DEBUG=true
DJANGO_SETTINGS_MODULE=sns.settings

# SvelteKit settings
SVELTEKIT_PORT=5173
SVELTEKIT_HOST=localhost

# Database settings
DATABASE_BACKUP_BEFORE_RESET=true
AUTO_MIGRATE=true

# Virtual environment settings
VENV_PATH=.venv
PYTHON_MIN_VERSION=3.8

# Node.js settings
NODE_MIN_VERSION=16

# Logging settings
LOG_LEVEL=INFO
LOG_FILE=scripts/logs/startup.log

# Path settings
FRONTEND_PATH=web-frontend/app
BACKEND_PATH=sns
REQUIREMENTS_FILE=requirements.txt

# Process management
GRACEFUL_SHUTDOWN_TIMEOUT=10